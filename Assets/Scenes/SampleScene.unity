  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33a5d073f086aa247a9bfd6b375b9887, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  notePanel: {fileID: 356686824}
  noteContentText: {fileID: 2109571556}
  noteText: "\"Benden sonra bu h\xFCcreye d\xFC\u015Fecek kader orta\u011F\u0131ma...\n\nUzun s\xFCredir bu so\u011Fuk zindanda tutsa\u011F\u0131m. H\xFCcreyi incelerken duvardaki bayra\u011F\u0131n arkas\u0131nda gizli bir b\xF6lme oldu\u011Funu ke\u015Ffettim. \u0130\xE7eride kilitli bir sand\u0131k ve sand\u0131\u011F\u0131n i\xE7inde bir asa ile b\xFCy\xFC kitab\u0131 var. Ne yaz\u0131k ki ben bir b\xFCy\xFCc\xFC de\u011Filim, bu emanetlerin g\xFCc\xFCn\xFC uyand\u0131ramad\u0131m.\n\nE\u011Fer asay\u0131 ve kitab\u0131 kullanabilecek kudrete sahipsen, sand\u0131\u011F\u0131n anahtar\u0131n\u0131 i\xE7erideki k\u0131r\u0131k masan\u0131n \xFCzerine b\u0131rakt\u0131m. Onlar\u0131 al ve buradan kurtul\""
  autoCloseDistance: 3
